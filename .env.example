# JobFusion AI - Environment Configuration Example

# Application
APP_ENV=development
SECRET_KEY=jobfusion-super-secret-production-key-change-me-32chars
JWT_SECRET=jobfusion-jwt-secret-token-key-change-me-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=jobfusion

# Frontend / Backend URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# AI / LLM Configuration (Pluggable: zero-cost local fallback by default)
LLM_PROVIDER=local
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=tfidf_local

# Initial Admin Seed Credentials
ADMIN_NAME=Admin Officer
ADMIN_EMAIL=admin@jobfusion.ai
ADMIN_PASSWORD=AdminPassword123!

# Discovery / Ingestion settings
DISCOVERY_MAX_JOBS_PER_SOURCE=50
