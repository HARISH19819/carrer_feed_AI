# Application Environment
APP_NAME="JobFusion AI"
APP_ENV="production"
DEBUG=false
API_V1_PREFIX="/api"

# Security (Change these in production!)
# Generate secure strings using: openssl rand -hex 32
SECRET_KEY="generate-a-secure-random-32-character-secret-key-here"
JWT_SECRET="generate-a-secure-random-32-character-jwt-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="jobfusion"

# CORS Origins (Comma-separated for multiple domains)
# Example: https://jobfusion.vercel.app,http://localhost:5173
ALLOWED_ORIGINS="http://localhost:5173,https://*.vercel.app,https://*.onrender.com"
FRONTEND_URL="http://localhost:5173"

# Admin Initial Credentials (Seeded on first startup if no admin exists)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@jobfusion.ai"
ADMIN_PASSWORD="ChangeMeInProduction123!"

# Ingestion Configuration
DISCOVERY_MAX_JOBS_PER_SOURCE=25
MAX_UPLOAD_SIZE_BYTES=10485760
